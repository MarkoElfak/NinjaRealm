.top-bar-row {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    border-top-width: 3px;
    border-top-color: var(--red);
}

.top-bar__heading {
    margin-right: 28px;
}

.top-bar__title {
    font-size: 19px;
    -unity-font-style: bold;
}

.top-bar__hint {
    font-size: 12px;
    color: var(--muted);
}

.clan {
    width: 130px;
    margin-right: 20px;
}

.clan__level {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.clan__xp {
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
}

.resource {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    margin-left: 6px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.resource__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.resource__name {
    font-size: 13px;
    color: var(--muted);
    margin-right: 6px;
}

.resource__amount {
    font-size: 16px;
    -unity-font-style: bold;
}

.resources {
    flex-direction: row;
}

.world-names {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.world-name__plate {
    background-color: var(--ink);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--line);
    padding: 3px 14px;
    font-size: 14px;
    -unity-font-style: bold;
}

.world-name--closed .world-name__plate {
    color: var(--muted);
}

.world-name--hovered .world-name__plate {
    background-color: rgb(82, 69, 31);
    border-color: var(--gold);
}

.world-name__chip {
    margin-top: 4px;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
}

.world-name__tip {
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 5px;
    background-color: var(--ink);
    font-size: 12px;
    max-width: 360px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.plaza-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
}

.plaza-name--hovered {
    background-color: rgba(82, 69, 31, 0.9);
}

.plaza-name__name {
    font-size: 13px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.plaza-name__level {
    font-size: 12px;
    color: var(--gold);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.plaza-name__hint {
    font-size: 11px;
    color: var(--muted);
}

.speech {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
}

.speech__box {
    flex-direction: row;
    align-items: center;
    max-width: 70%;
    padding: 8px 18px;
    border-color: var(--line-strong);
}

.speech__name {
    margin-right: 10px;
    font-size: 16px;
    -unity-font-style: bold;
}

.speech__text {
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-style: italic;
    white-space: normal;
}

/* The rune rail: the altar's runes down the left side */

.rune-rail {
    position: absolute;
    left: 12px;
    top: 96px;
    width: 220px;
    padding: 8px 10px;
    border-top-width: 3px;
    border-top-color: rgb(166, 115, 242);
}

.rune-rail:hover {
    border-color: var(--gold);
}

.rune-rail__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.rune-rail__title {
    font-size: 15px;
    -unity-font-style: bold;
}

.rune-rail__count {
    font-size: 12px;
    color: var(--muted);
}

.rune-rail__slot {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 3px 4px;
    border-radius: 5px;
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.04);
}

.rune-rail__slot--locked {
    opacity: 0.55;
}

.rune-rail__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.rune-rail__icon--empty {
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(0, 0, 0, 0.25);
    justify-content: center;
}

.rune-rail__plus {
    -unity-text-align: middle-center;
    font-size: 18px;
    color: var(--muted);
}

.rune-rail__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.rune-rail__name {
    font-size: 12px;
    -unity-font-style: bold;
}

.rune-rail__effect {
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
}

.rune-rail__karma {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.rune-rail__karma-text {
    font-size: 12px;
    -unity-font-style: bold;
    flex-shrink: 1;
}

.rune-rail__collect {
    margin: 0;
    flex-shrink: 0;
}

.rune-rail__hint {
    font-size: 11px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-top: 2px;
}
