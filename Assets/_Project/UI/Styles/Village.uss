.top-bar-row {
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    border-top-width: 3px;
    border-top-color: var(--red);
}

.top-bar__heading {
    margin-right: 28px;
}

.top-bar__title {
    font-size: 19px;
    -unity-font-style: bold;
}

.top-bar__hint {
    font-size: 12px;
    color: var(--muted);
}

.clan {
    width: 130px;
    margin-right: 20px;
}

.clan__level {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.clan__xp {
    font-size: 11px;
    color: var(--muted);
    margin-top: 3px;
}

.resource {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    margin-left: 6px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.resource__dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.resource__name {
    font-size: 13px;
    color: var(--muted);
    margin-right: 6px;
}

.resource__amount {
    font-size: 16px;
    -unity-font-style: bold;
}

.resources {
    flex-direction: row;
}

.world-names {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.world-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.world-name__plate {
    background-color: var(--ink);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--line);
    padding: 3px 14px;
    font-size: 14px;
    -unity-font-style: bold;
}

.world-name--closed .world-name__plate {
    color: var(--muted);
}

.world-name--hovered .world-name__plate {
    background-color: rgb(82, 69, 31);
    border-color: var(--gold);
}

.world-name__chip {
    margin-top: 4px;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
}

.world-name__tip {
    margin-top: 4px;
    padding: 3px 10px;
    border-radius: 5px;
    background-color: var(--ink);
    font-size: 12px;
    max-width: 360px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.plaza-name {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
}

.plaza-name--hovered {
    background-color: rgba(82, 69, 31, 0.9);
}

.plaza-name__name {
    font-size: 13px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.plaza-name__level {
    font-size: 12px;
    color: var(--gold);
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.plaza-name__hint {
    font-size: 11px;
    color: var(--muted);
}
